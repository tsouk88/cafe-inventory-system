  "claims": [
    {
      "id": "claim_e816e291cb5f4108a51cd85190e36cf1",
      "statement": "The four core entities are Variety, Product, Batch, and StockMovement defined in models.py; products and batches both carry a variety_id foreign key, and stock_movements.barcode is a nullable FK to products.barcode so manual deductions and batch restocks are not tied to a product.",
      "evidence": [
        {
          "resource": "repo://models.py#L14-L45",
          "version": "repo-lines-v1:sha256:795916abe45ebff61c12f005052acd328eb1576571cc7675fb3fbbc3a1ccbc42:"
        }
      ]
    },
    {
      "id": "claim_ea72d62ac3b8439b88ca01a1cdcc4310",
      "statement": "Variety.tracking_type (TrackingType enum: WEIGHT or UNITS) is the branch that governs how stock is consumed: scanning resolves the product, then uses the variety's tracking_type to decide the deduction path.",
      "evidence": [
        {
          "resource": "repo://main.py#L70-L125",
          "version": "repo-lines-v1:sha256:1c4d0cdd3c4765682e2dd96feabbdfc9f70132aecf825be663976db680782d4f:"
        },
        {
          "resource": "repo://models.py#L10-L12",
          "version": "repo-lines-v1:sha256:1cfa4cb54b0ec01718f7393b011c7ca8c9ef8fb0ba4c0ee124fb90d6ed26a789:"
        }
      ]
    },
    {
      "id": "claim_f88d3542099e42ed9f8f3433ca2983c6",
      "statement": "Product.barcode is the primary key of products; package_size_grams is nullable but required for weight-tracked products because a scan consumes exactly that many grams.",
      "evidence": [
        {
          "resource": "repo://main.py#L76-L79",
          "version": "repo-lines-v1:sha256:c109a3ba549b3427462eb54b59a70d3d4f8cf42b7c6501623140f3206ba93244:"
        },
