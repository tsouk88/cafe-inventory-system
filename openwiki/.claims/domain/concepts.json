    {
      "id": "claim_026721d089944377b3b157dbc4792456",
      "statement": "When a scan cannot be fully covered by on-file batches, scan_barcode records the full package_size_grams as the OUT movement and returns status 'stock_mismatch' with the stock_shortfall; only full coverage returns 'completed'.",
