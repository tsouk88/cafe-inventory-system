        }
      ]
    },
    {
      "id": "claim_8ece0dec6ed0448f87870edb5127e54f",
      "statement": "FIFO is by earliest expiry_date first, not by insertion order: scan_barcode and manual_deduct order batches by Batch.expiry_date and spill remaining demand across later batches when the earliest is exhausted; this is the central invariant to preserve.",
      "evidence": [
        {
          "resource": "repo://main.py#L134-L168",
          "version": "repo-lines-v1:sha256:bbcfe551a02e2b27a3a5ddbbc967c03030f962b970230e8c4be64f339eca736c:"
        },
        {
          "resource": "repo://main.py#L80-L89",
          "version": "repo-lines-v1:sha256:1863f9331a824f880cf5547a0830516b159678c29922d86447aa25adb4dae5b2:"
        }
      ]
    },
    {
      "id": "claim_17b1689c63844d509e402650c36613fa",
      "statement": "The StockMovement.grams column is overloaded: it stores gram amounts for weight-tracked items but unit counts for unit-tracked items. create_batch stores units_remaining in grams for unit batches and scan_barcode stores grams=1 per unit scan, and scripts/low_stock.py sums movement.grams across both tracking types to estimate weekly consumption.",
      "evidence": [
        {
          "resource": "repo://main.py#L114-L119",
          "version": "repo-lines-v1:sha256:51347acd506515bfe3c7b958afd96cdcd6d428f34565a9cb78617f4652b6205f:"
