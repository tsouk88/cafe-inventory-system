    {
      "id": "claim_1c3e61abad594018bab11e5713183fa5",
      "statement": "POST /batches/{batch_id}/discard guards in order: 404 for unknown batch, 409 'Batch is already 0' when grams_remaining == 0 or units_remaining == 0 (relying on None == 0 being false so only the set column can trip it), and 409 'Batch has not expired yet' when expiry_date >= date.today() — only a strictly past expiry may be discarded.",
      "evidence": [
        {
          "resource": "repo://main.py#L217-L243",
          "version": "repo-lines-v1:sha256:24b58daa6cfc416b7a36084fc4944396c87c408264c2e95dd80f7317c7d092c7:"
        }
      ]
    },
    {
      "id": "claim_451889fba2374ea7837a2b14ec903c03",
      "statement": "On successful discard, the handler zeroes whichever remaining column is not None and writes exactly one StockMovement with barcode=None, direction=OUT, reason=EXPIRED, grams equal to the full remaining quantity just zeroed; the /reports/waste endpoint aggregates these EXPIRED movements per variety.",
      "evidence": [
        {
          "resource": "repo://main.py#L226-L243",
