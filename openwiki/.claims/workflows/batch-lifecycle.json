  "claims": [
    {
      "id": "claim_6abbb8025c234a07ab7bbf5c92c793cf",
      "statement": "Batches are created only via POST /batches (create_batch), which inserts the Batch with received_at defaulting to now-UTC, flushes to obtain the id, then writes one StockMovement with barcode=None, direction=IN, reason=RESTOCK whose grams mirrors whichever quantity was provided (grams_remaining for weight batches, units_remaining for unit batches), committing everything in one transaction.",
      "evidence": [
        {
          "resource": "repo://main.py#L45-L69",
          "version": "repo-lines-v1:sha256:7b6fc9f2e59b65029a282cbcf83347423581198e5b8d7888e1effbbf6f7b36b8:"
        },
        {
          "resource": "repo://models.py#L34-L42",
          "version": "repo-lines-v1:sha256:7f53db71a0c77478b7c919ace50f6fb7a3af502e20afaf5b5b0ffda83f1e585e:"
        }
      ]
    },
    {
      "id": "claim_a43a1be609704ded886d2f42537f05ec",
      "statement": "BatchCreate requires at least one of grams_remaining or units_remaining via a model_validator that rejects payloads with both None; the RestockModal frontend enforces the mirror-image rule by showing a grams field only for weight varieties and a units field only for units varieties, sending the non-matching field as an explicit null.",
      "evidence": [
        {
          "resource": "repo://frontend/src/RestockModal.jsx#L37-L49",
          "version": "repo-lines-v1:sha256:95410719672a3ee0c284fe39607bd2349ec23added5546ab3fba07ffa3188abb:"
