    {
      "id": "claim_327e14b680374a95997bca7ff6c81063",
      "statement": "POST /batches/{batch_id}/correct?counted=N guards in evaluation order: 400 'Wrong Number' for counted < 0 (checked before the batch lookup, so a negative counted with an unknown id returns 400 not 404), 404 for unknown batch, and 409 'Stock already matches' when counted equals the current remaining value; correction has no expiry guard so expired batches can still be corrected.",
      "evidence": [
        {
          "resource": "repo://main.py#L245-L301",
          "version": "repo-lines-v1:sha256:4f12160b531e94ef9a726f352f7f618b548cf034038989c9550e5060c3c55fbb:"
        }
