    {
      "id": "claim_44e1d588337c4cbf8a5b57d1713e7ccd",
      "statement": "The four report endpoints (/reports/stock-per-variety, /reports/fefo-next, /reports/expired-with-stock, /reports/last7) all use raw SQL via db.execute(text(...)) and return .mappings().all() with no declared response_model, so JSON keys come straight from the SQL column aliases rather than from ORM/Pydantic schemas.",
      "evidence": [
        {
          "resource": "repo://main.py#L182-L239",
          "version": "repo-lines-v1:sha256:4dccc92187306d67b8651a7168e249ba8c295bda5f857f376de0e758cb13950c:"
        }
      ]
    },
    {
      "id": "claim_4d5fbda48a11426d804d4ae59cb2fa60",
      "statement": "stock-per-variety returns name, remaining (coalesced sum of units_remaining/grams_remaining across batches with stock), active_batches (count of batch ids), and tracking_type; fefo-next returns the earliest-expiring batch per variety that still has stock with expiry_date > now(); expired-with-stock returns batches past expiry that still carry remaining stock; last7 returns StockMovement rows from the last 7 days with variety name (may be null for manual movements), timestamp, direction, and stock (the grams column), newest first.",
      "evidence": [
        {
