    {
      "id": "claim_205edf13ef5e4060a69c02294e2bba3c",
      "statement": "scripts/low_stock.py is a standalone scheduled script (not an API route) that queries OUT StockMovements from the last 7 days joined to Product on barcode to recover variety_id, sums movement.grams per variety, sums remaining stock (grams_remaining for WEIGHT, units_remaining for UNITS) per variety, computes days_left = remaining * 7 / consumed, flags varieties with days_left < 5, and emails via smtplib to smtp.gmail.com:587 using GMAIL_ADDRESS/GMAIL_PASSWORD, printing 'No low stocks detected' when nothing is low.",
      "evidence": [
