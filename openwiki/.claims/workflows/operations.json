  "claims": [
    {
      "id": "claim_ed3fd7af05e54e40b46e5184fcfc1004",
      "statement": "POST /scan branches on variety.tracking_type: the WEIGHT branch subtracts product.package_size_grams by walking batches ordered by Batch.expiry_date ascending, zeroing batches and tracking an uncovered stock_shortfall, returning status 'completed' when the shortfall is 0 and 'stock_mismatch' otherwise; the UNITS branch finds the first batch (by expiry_date) with units_remaining > 0 and decrements exactly 1, always returning units_removed=1 and status 'completed'.",
      "evidence": [
        {
          "resource": "repo://main.py#L70-L125",
          "version": "repo-lines-v1:sha256:1c4d0cdd3c4765682e2dd96feabbdfc9f70132aecf825be663976db680782d4f:"
        }
      ]
    },
    {
      "id": "claim_e1da804bbd2a4e7a88c6a7b0e00e6a13",
      "statement": "POST /scan for a WEIGHT product always records a StockMovement with grams equal to the full product.package_size_grams regardless of shortfall, while the UNITS branch records grams=1 (the overloaded unit count).",
      "evidence": [
        {
          "resource": "repo://main.py#L98-L119",
          "version": "repo-lines-v1:sha256:28355a70509cc8340221bb1e0aacf5d583801f09c9bfba5c4d166a847333f76e:"
        }
      ]
    },
    {
      "id": "claim_90a6f2834fd945228b8e8b1dc5418207",
      "statement": "POST /deduct applies FIFO by Batch.expiry_date but behaves inconsistently: the WEIGHT branch always returns status 'completed' and never reports a shortfall even when batches cannot cover the requested grams, whereas the UNITS branch subtracts deduct.units with spillover, computes units_removed, and returns 'stock_mismatch' when remaining_to_subtract is non-zero.",
      "evidence": [
        {
          "resource": "repo://main.py#L127-L240",
          "version": "repo-lines-v1:sha256:f225213a1cb7ced7a722875206b04bd8d5a8a7965fc91dde810c8d7afa64497f:"
        }
      ]
    },
