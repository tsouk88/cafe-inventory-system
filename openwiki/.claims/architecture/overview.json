    {
      "id": "claim_c5f7316cc624418299505b44bca1d19b",
      "statement": "The app is a single-deployment full-stack system: main.py mounts the built React SPA with app.frontend(\"/\", directory=\"frontend/dist\") and the frontend uses an empty API_BASE so all fetch calls are same-origin relative paths against the FastAPI process that owns the API.",
      "evidence": [
        {
          "resource": "repo://frontend/src/App.jsx#L7-L7",
          "version": "repo-lines-v1:sha256:cc206438df451e7329f5bc74877716031f1871eac4b00b7766627f127e3c42c8:"
        },
        {
          "resource": "repo://main.py#L17-L17",
          "version": "repo-lines-v1:sha256:b540061c89ec5e121a1e981bd149a3c05351d938475025b84ff639c16abadb23:"
        }
      ]
    },
    {
      "id": "claim_02885f2277214bc7afeb3c40ec8ab3e6",
      "statement": "CORS is configured for the local Vite dev server origin only (allow_origins=[\"http://localhost:5173\"]); in same-origin deployed serving the SPA does not need CORS, so this middleware exists solely for local development where the SPA runs on port 5173.",
      "evidence": [
        {
          "resource": "repo://frontend/vite.config.js",
          "version": "repo-file-v1:sha256:4d36db3522a7b2dd10e0936e1004373c7ee65f10f7cd7920cd76410459c15a45"
